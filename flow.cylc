#!jinja2
{% from 'metomi' import isodatetime %}
{% set USER_EMAILS = "sateesh.masabathini@kaust.edu.sa" %}

[scheduler]
    allow implicit tasks = True
    cycle point format = CCYYMMDDThhZ

[task parameters]
    type = 'AER', 'CHM'  #'ASM'
    [[templates]]
        type = %(type)s

[scheduling]
    initial cycle point = 20150101T00Z
    final cycle point = 20150101T00Z
    runahead limit = P1D
    [[queues]]
        [[[limitrunqueue]]]
            limit = 2
            members = DOWNLOAD

    [[graph]]
        P1D = """
            downloadMerra_<type> => merge => archive
            """

[runtime]
    [[root]]
        init-script = """
            set -uex
            source ${HOME}/miniforge3/bin/activate ${HOME}/miniforge3/envs/cylc
            echo $PATH
            export USER_EMAILS={{USER_EMAILS}}
            """
        err-script = err-emailAlart.sh
        submission retry delays = 2*PT2M
        execution retry delays = 2*PT10M
        [[[environment]]]
            USER_EMAILS = {{USER_EMAILS}}
        [[[meta]]]
            description = " MERRA2 data download"
            owner = "sateesh.masabathini@kaust.edu.sa"
            team = "Data Production team."
        [[[mail]]]
            to = {{ USER_EMAILS }}
        [[[events]]]
            mail events = submission failed, submission timeout, failed
        [[[environment]]]
    [[DOWNLOAD]]
        script = """
            mkdir -p ${archive}
            python ${CYLC_WORKFLOW_RUN_DIR}/lib/python/downloadMerra2reanalysis.py ${CYLC_TASK_PARAM_type} ${datestamp} ${archive}
            """
        platform = shaheennew_login
    [[downloadMerra_<type>]]
        inherit = DOWNLOAD
        [[[environment]]]
            datestamp = $(isodatetime  $CYLC_TASK_CYCLE_POINT  -f "%Y-%m-%d")
            archive = ${CYLC_WORKFLOW_WORK_DIR}/${CYLC_TASK_CYCLE_POINT}/archive
    [[merge]]
        script = """
            set -uex
            rm -rfv *
            python ${CYLC_WORKFLOW_RUN_DIR}/lib/python/mergenetcdf.py ${input} ${outputfile} 
            """
        platform = shaheennew
        [[[environment]]]
            input = ${CYLC_WORKFLOW_WORK_DIR}/${CYLC_TASK_CYCLE_POINT}/archive/
            outputfile = $(isodatetime $CYLC_TASK_CYCLE_POINT  -f "GEOS.fp.fcast.inst3_3d_ALL_Nv_%Y%m%d_%H.nc")
    [[archive]]
        script = """
            set -uex
            mkdir -p ${CYLC_TASK_CYCLE_POINT}
            cp ${inputpath}/${inputfile}  ${output}/
            """
        [[[environment]]]
            inputfile = $(isodatetime $CYLC_TASK_CYCLE_POINT  -f "GEOS.fp.fcast.inst3_3d_ALL_Nv_%Y%m%d_%H.nc")
            inputpath = ${CYLC_WORKFLOW_WORK_DIR}/${CYLC_TASK_CYCLE_POINT}/merge
            output = /scratch/masabas/k10021/forcing_downloaded/input-GEOS5dustIC/${CYLC_TASK_CYCLE_POINT}
